[29.783650426010706, "o", "\u001b[?25l\u001b[38;5;215m\u001b[2ddemo $ \u001b[39mcurl -fL --progress-bar https://peachq.org/download/peachq-linux-x64.tar.gz -o peachq.tar.gz\u001b[K\u001b[3;66H##################################################################################################### 100.0%\u001b[38;5;215m\u001b[4;66Hdemo $ \u001b[39mtar -xzf peachq.tar.gz -C peachq\u001b[K\u001b[38;5;215m\u001b[5;66Hdemo $ \u001b[39mexport PATH=\"$PWD/peachq:$PATH\"\u001b[K\u001b[38;5;215m\u001b[6;66Hdemo $ \u001b[39mTORQ_REV=7e77714a62fb49dc42b11500a96bcfa535ce9a19\u001b[K\u001b[38;5;215m\u001b[7;66Hdemo $ \u001b[39mFSP_REV=50fcd5ad6d8e50fcd71965010ce38a1fccdad87b\u001b[K\u001b[38;5;215m\u001b[8;66Hdemo $ \u001b[39mcurl -fL --progress-bar \"https://github.com/DataIntellectTech/TorQ/archive/$TORQ_REV.tar.gz\" -o \"TorQ\u001b[9;66H-$TORQ_REV.tar.gz\"\u001b[K\u001b[10;66H##################################################################################################### 100.0%\u001b[38;5;215m\u001b[11;66Hdemo $ \u001b[39mcurl -fL --progress-bar \"https://github.com/DataIntellectTech/TorQ-Finance-Starter-Pack/archive/$FSP_\u001b[12;66HREV.tar.gz\" -o \"TorQ-Finance-Starter-Pack-$FSP_REV.tar.gz\"\u001b[K\u001b[13;66H#####"]
[29.783717426010707, "o", "################################################################################################ 100.0%\u001b[38;5;215m\u001b[14;66Hdemo $ \u001b[39mtar -xzf \"TorQ-$TORQ_REV.tar.gz\"\u001b[K\u001b[38;5;215m\u001b[15;66Hdemo $ \u001b[39mbash \"TorQ-$TORQ_REV/installtorqapp.sh\" \\\u001b[K\u001b[16;66H  --torq \"$PWD/TorQ-$TORQ_REV.tar.gz\" \\\u001b[K\u001b[17;66H  --installfile \"$PWD/TorQ-Finance-Starter-Pack-$FSP_REV.tar.gz\" \\\u001b[K\u001b[18;66H  --releasedir \"$PWD/deploy\" --data \"$PWD/data\"\u001b[K\u001b[19;66H\u001b[K\n=============================================================\u001b[K\u001b[21;66HVARIABLES DEFINED FOR THE INSTALLATION SCRIPT:\u001b[K\u001b[22;66H=============================================================\u001b[K\u001b[23;66Htorq = /tmp/peachq-torq-13wvh9dk/TorQ-7e77714a62fb49dc42b11500a96bcfa535ce9a19.tar.gz\u001b[K\u001b[24;66Hreleasedir = /tmp/peachq-torq-13wvh9dk/deploy\u001b[K\u001b[25;66Henv = \u001b[K\u001b[26;66Hinstallfile = /tmp/peachq-torq-13wvh9dk/TorQ-Finance-Starter-Pack-50fcd5ad6d8e50fcd71965010ce38a1fccdad87b.t\u001b[27;66Har.gz\u001b[K\u001b[28;66Hdata = /tmp/peachq-torq-13wvh9dk/data \u001b[K\u001b[29;66H\u001b[K\n============================"]
