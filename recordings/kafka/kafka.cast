[161.330665, "o", "\u001b[?25l\u001b[38;5;240m\u001b[1;3H Kafka feed (rpk) ────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[38;5;240m\u001b[17;3H q: ingest A ─────────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[38;5;215m\u001b[1;90H q: consumer B ───────────────────────────────────────────────────────────────────\u001b[H\u001b[38;5;240m──\u001b[82C──\u001b[38;5;215m┬──\u001b[82C──\u001b[2;87H│\u001b[3;87H│\u001b[4;87H│\u001b[5;87H│\u001b[6;87H│\u001b[7;87H│\u001b[8;87H│\u001b[9;87H│\u001b[10;87H│\u001b[11;87H│\u001b[12;87H│\u001b[13;87H│\u001b[14;87H│\u001b[15;87H│\u001b[16;87H│\r\n\u001b[38;5;240m──\u001b[82C──\u001b[38;5;215m┤\u001b[18;87H│\u001b[19;87H│\u001b[20;87H│\u001b[21;87H│"]
