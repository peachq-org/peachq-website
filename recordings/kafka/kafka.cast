[160.318247, "o", "\u001b[2;48r\u001b[48;88H\u001b[K\u001b[1;49r\u001b[48;95H\u001b[?2004h\u001b[?25l\u001b[2;88Hq)\u001b[38;5;33mselect\u001b[39m topic\u001b[38;5;141m,\u001b[39mcommitted\u001b[38;5;141m,\u001b[39mposition \u001b[38;5;33mfrom\u001b[39m .kafka.offsets b\u001b[K\u001b[3;88H| topic       | committed | position |\u001b[K\u001b[4;88H| symbol      | long      | long     |\u001b[K\u001b[5;88H|-------------|-----------|----------|\u001b[K\u001b[6;88H| demo.trades |           | 8        |\u001b[K\u001b[7;88Hq).kafka.commit[b;\u001b[38;5;33mraze\u001b[39m buf]\u001b[K\u001b[8;88Hq)\u001b[38;5;33mselect\u001b[39m topic\u001b[38;5;141m,\u001b[39mcommitted\u001b[38;5;141m,\u001b[39mposition \u001b[38;5;33mfrom\u001b[39m .kafka.offsets b\u001b[K\u001b[9;88H| topic       | committed | position |\u001b[K\u001b[10;88H| symbol      | long      | long     |\u001b[K\u001b[11;88H|-------------|-----------|----------|\u001b[K\u001b[12;88H| demo.trades | 8         | 8        |\u001b[K\u001b[13;88Hq)\u001b[38;5;244m/ Nothing was committed until .kafka.commit was given the rows.\u001b[39m\u001b[K\u001b[14;88Hq)\u001b[38;5;244m/ Consumer B lands the JSON topic in its own table.\u001b[39m\u001b[K\u001b[15;88Hq).kafka.sub[b;\u001b[38;5;37m`demo.vwap\u001b[39m;\u001b[38;5;37m`vwap\u001b[39m]\u001b[K\u001b[16;88Hq)vwap\u001b[K\u001b[17;88H| sym    | vwa"]
