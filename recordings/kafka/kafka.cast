[164.530242, "o", "\u001b[?25l\u001b[2;1HProduced to partition 0 at offset 2 with timestamp 1792620158957.\u001b[21X\r\nProduced to partition 0 at offset 3 with timestamp 1792620158957.\u001b[21X\r\nProduced to partition 0 at offset 4 with timestamp 1792620158957.\u001b[21X\u001b[38;5;215m\r\ndemo $ \u001b[39m# Five messages; the one at offset 3 is cut-off JSON.\u001b[26X\u001b[38;5;215m\r\ndemo $ \u001b[39mrpk topic produce demo.trades -f '%k %v\\n' <<'EOF'\u001b[29X\u001b[7;86H\u001b[1K\rIBM {\"sym\":\"IBM\",\"px\":231.4,\"qty\":300}\u001b[8;86H\u001b[1K\rAAPL {\"sym\":\"AAPL\",\"px\":188.1,\"qty\":120}\u001b[9;86H\u001b[1K\rIBM {\"sym\":\"IBM\",\"px\":231.8,\"qty\":100}\u001b[10;86H\u001b[1K\rEOF\r\nProduced to partition 0 at offset 5 with timestamp 1792620191721.\u001b[21X\r\nProduced to partition 0 at offset 6 with timestamp 1792620191721.\u001b[21X\r\nProduced to partition 0 at offset 7 with timestamp 1792620191721.\u001b[21X\u001b[38;5;215m\r\ndemo $ \u001b[39m# A second batch, while q sits at its prompt.\u001b[34X\u001b[38;5;215m\r\ndemo $ \u001b[39m# 7. Clean up the demo groups and topics.\u001b[38X\u001b[16;86H\u001b[1K\u001b[38;5;215m\rdemo $ \u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
