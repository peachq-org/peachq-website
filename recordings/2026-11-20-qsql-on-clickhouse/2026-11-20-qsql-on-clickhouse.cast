[32.665381, "o", "WITH `_q_src` AS (SELECT `date` AS `date`, `time` AS `time`, `sym` AS `sym`, `ex` AS `ex`, `cond` AS `cond`, if(isNaN(`price`), NULL, `price`) AS `price`, `size` AS `size`, nullIf(`seq`, -9223372036854775808) AS `seq`, nullIf(`tradeId`, -9223372036854775808) AS `tradeId`, nullIf(`corr`, -2147483648) AS `corr`, `date` AS `_q_raw_date`, `time` AS `_q_raw_time`, `sym` AS `_q_raw_sym`, `ex` AS `_q_raw_ex`, `cond` AS `_q_raw_cond`, `price` AS `_q_raw_price`, `size` AS `_q_raw_size`, `seq` AS `_q_raw_seq`, `tradeId` AS `_q_raw_tradeId`, `corr` AS `_q_raw_corr`, tuple(sym, time, seq) AS `i`, tuple(`time`, `seq`) AS `_q_i1`, tuple(`seq`) AS `_q_i2`, toInt32(toHour(`time`, 'UTC') * 60 + toMinute(`time`, 'UTC')) AS `_q_min_time` FROM `taq`.`trade`) SELECT CAST(_q_min_time - (_q_min_time % 5 + 5) % 5 AS BIGINT) AS minute, sym, if(isNaN(argMin(_q_raw_price, _q_i1)), NULL, argMin(_q_raw_price, _q_i1)) AS o, coalesce(max(price), -inf) AS h, coalesce(min(price), inf) AS l, if(isNaN(argMax(_q_raw_price, _q_i1)), NULL, argMax"]
[32.665396, "o", "(_q_raw_price, _q_i1)) AS c, CAST(coalesce(sum(size), 0) AS BIGINT) AS v FROM _q_src WHERE _q_raw_date = toDate32('2025-07-02') AND _q_raw_sym IN ('BAA', 'BAB', 'BAC') GROUP BY CAST(_q_min_time - (_q_min_time % 5 + 5) % 5 AS BIGINT), sym ORDER BY CAST(_q_min_time - (_q_min_time % 5 + 5) % 5 AS BIGINT) NULLS FIRST, sym FORMAT Parquet\r\nq)"]
