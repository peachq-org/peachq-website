[110.45179012699401, "o", "\u001b[2;48r\u001b[2;59H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[1;49r\u001b[2;59H\u001b[?2004h\u001b[38;5;215mdemo $ \u001b(B\u001b[m"]
[111.91749212699402, "o", "\u001b[7m# qPython: query the same PeachQ server\u001b[3;59Hpython - <<'PY'\u001b[4;59Himport numpy as np\u001b[5;59Hfrom qpython.qconnection import QConnection\u001b[7;59Hwith QConnection(host='127.0.0.1', port=5010) as q:\u001b[8;59H    assert q.sendSync('1+1') == 2\u001b[9;59H    total = q.sendSync('{sum x}', np.array([10, 5, 20], dtype=np.int64))\u001b[10;59H    assert total == 35\u001b[11;59H    print(total)\u001b[12;59H    print(q.sendSync('([]sym:`AAPL`MSFT;volume:30 5;notional:3200 1000f)'))\u001b[13;59HPY\u001b(B\u001b[m"]
[111.94138012699402, "o", "\u001b[2;59H\u001b[38;5;215mdemo $ \u001b[39m# qPython: query the same PeachQ server\u001b[3;59Hpython - <<'PY'\u001b[4;59Himport numpy as np\u001b[5;59Hfrom qpython.qconnection import QConnection\u001b[7;59Hwith QConnection(host='127.0.0.1', port=5010) as q:\u001b[8;59H    assert q.sendSync('1+1') == 2\u001b[9;59H    total = q.sendSync('{sum x}', np.array([10, 5, 20], dtype=np.int64))\u001b[10;59H    assert total == 35\u001b[11;59H    print(total)\u001b[12;59H    print(q.sendSync('([]sym:`AAPL`MSFT;volume:30 5;notional:3200 1000f)'))\u001b[13;59HPY\u001b[14;59H\u001b[?2004l"]
[112.27215512699402, "o", "35\u001b[15;59H"]
[112.27361912699402, "o", "[(b'AAPL', 30, 3200.) (b'MSFT',  5, 1000.)]\u001b[16;59H"]
[112.43733812699402, "o", "\u001b[38;5;215mdemo $ \u001b[?2004h\u001b(B\u001b[m"]
