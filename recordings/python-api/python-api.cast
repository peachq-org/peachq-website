[64.68160712699402, "o", "\u001b[2;48r\u001b[2;59H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[2d\u001b[38;5;215mdemo $ \u001b[1;49r\u001b[2;66H\u001b[?2004h\u001b(B\u001b[m"]
[65.98184812699402, "o", "\u001b[7m# Kola: send a table and get the totals back\u001b[3;59Hpython - <<'PY'\u001b[4;59Himport polars as pl\u001b[5;59Hfrom kola import Q\u001b[7;59Htrades = pl.DataFrame({\u001b[8;59H    'sym': ['AAPL', 'MSFT', 'AAPL'],\u001b[9;59H    'price': [100., 200., 110.],\u001b[10;59H    'size': [10, 5, 20],\u001b[11;59H}).with_columns(pl.col('sym').cast(pl.Categorical))\u001b[13;59Hq = Q('127.0.0.1', 5010)\u001b[14;59Hq.connect()\u001b[15;59Htry:\u001b[16;59H    q.sync('set', 'trade', trades)\u001b[17;59H    assert q.sync('count trade') == 3\u001b[18;59H    result = q.sync('0!select volume:sum size,notional:sum price*size by sym from trade')\u001b[19;59H    assert result.to_dicts() == [\u001b[20;59H        {'sym': 'AAPL', 'volume': 30, 'notional': 3200.},\u001b[21;59H        {'sym': 'MSFT', 'volume': 5, 'notional': 1000.},\u001b[22;59H    ]\u001b[23;59H    print(result)\u001b[24;59Hfinally:\u001b[25;59H    q.disconnect()\u001b[26;59HPY\u001b(B\u001b[m"]
[66.02294212699402, "o", "\u001b[2;59H\u001b[38;5;215mdemo $ \u001b[39m# Kola: send a table and get the totals back\u001b[3;59Hpython - <<'PY'\u001b[4;59Himport polars as pl\u001b[5;59Hfrom kola import Q\u001b[7;59Htrades = pl.DataFrame({\u001b[8;59H    'sym': ['AAPL', 'MSFT', 'AAPL'],\u001b[9;59H    'price': [100., 200., 110.],\u001b[10;59H    'size': [10, 5, 20],\u001b[11;59H}).with_columns(pl.col('sym').cast(pl.Categorical))\u001b[13;59Hq = Q('127.0.0.1', 5010)\u001b[14;59Hq.connect()\u001b[15;59Htry:\u001b[16;59H    q.sync('set', 'trade', trades)\u001b[17;59H    assert q.sync('count trade') == 3\u001b[18;59H    result = q.sync('0!select volume:sum size,notional:sum price*size by sym from trade')\u001b[19;59H    assert result.to_dicts() == [\u001b[20;59H        {'sym': 'AAPL', 'volume': 30, 'notional': 3200.},\u001b[21;59H        {'sym': 'MSFT', 'volume': 5, 'notional': 1000.},\u001b[22;59H    ]\u001b[23;59H    print(result)\u001b[24;59Hfinally:\u001b[25;59H    q.disconnect()\u001b[26;59HPY\u001b[27;59H\u001b[?2004l"]
[66.65615812699401, "o", "shape: (2, 3)\u001b[28;59H┌──────┬────────┬──────────┐\u001b[29;59H│ sym  ┆ volume ┆ notional │\u001b[30;59H│ ---  ┆ ---    ┆ ---      │\u001b[31;59H│ cat  ┆ i64    ┆ f64      │\u001b[32;59H╞══════╪════════╪══════════╡\u001b[33;59H│ AAPL ┆ 30     ┆ 3200.0   │\u001b[34;59H│ MSFT ┆ 5      ┆ 1000.0   │\u001b[35;59H└──────┴────────┴──────────┘\u001b[36;59H\u001b[?25l\u001b[38;5;240m\u001b[1;3H PeachQ server :5010 ────────────────────────────────\u001b(B\u001b[m\u001b[38;5;215m\u001b[5C Python clients and compatibility tests ───────────────────────────────────────────────────────────────────────\u001b[H\u001b[38;5;240m──\u001b[53C──\u001b[38;5;215m┬──\u001b[111C──\u001b[2;58H│\u001b[3;58H│\u001b[4;58H│"]
