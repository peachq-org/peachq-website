[550.179168, "o", ";60H\u001b[K\n  git switch -c <new-branch-name>\u001b[K\u001b[18;60H\u001b[K\nOr undo this operation with:\u001b[K\u001b[20;60H\u001b[K\n  git switch -\u001b[K\u001b[22;60H\u001b[K\nTurn off this advice by setting config variable advice.detachedHead to false\u001b[K\u001b[24;60H\u001b[K\u001b[38;5;215m\ndemo $ \u001b[39mmkdir -p tick && curl -fsSL https://raw.githubusercontent.com/KxSystems/kdb-tick/master/tick/u.q -o tick/u.\u001b[26;60Hq && ls tick\u001b[K\u001b[27;60Hu.q\u001b[K\u001b[38;5;215m\u001b[28;60Hdemo $ \u001b[39mopenssl req -x509 -newkey rsa:2048 -nodes -subj /CN=localhost -keyout key.pem -out cert.pem -days 1 2>/dev/\u001b[29;60Hnull\u001b[K\u001b[38;5;215m\u001b[30;60Hdemo $ \u001b[39mSSL_CERT_FILE=$PWD/cert.pem SSL_KEY_FILE=$PWD/key.pem ./peachq/q -p 6000 -E 2 -q </dev/null >tls.log 2>&1 &\u001b[31;60H[1] 415816\u001b[K\u001b[38;5;215m\u001b[32;60Hdemo $ \u001b[39mcd node-q && npm install\u001b[K\u001b[1m\u001b[33;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mold lockfile\u001b[39m\u001b[K\u001b[1m\u001b[34;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mold lockfile\u001b[39m The package-lock.json file was created with an old version of npm,\u001b[K\u001b[1m\u001b[35;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mold lockfile\u001b[39m so supplemental m"]
[550.17932, "o", "etadata must be fetched from the registry.\u001b[K\u001b[1m\u001b[36;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mold lockfile\u001b[39m\u001b[K\u001b[1m\u001b[37;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mold lockfile\u001b[39m This is a one-time fix-up, please be patient...\u001b[K\u001b[1m\u001b[38;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mold lockfile\u001b[39m\u001b[K\u001b[1m\u001b[39;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mdeprecated\u001b[39m minimatch@2.0.10: Please update to minimatch 3.0.2 or higher to avoid a RegExp DoS issue\u001b[K\u001b[1m\u001b[40;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mdeprecated\u001b[39m inflight@1.0.6: This module is not supported, and leaks memory. Do not use it. Check out lru-c\u001b[41;60Hache if you want a good and tested way to coalesce async requests by a key value, which is much more comprehensive\u001b[42;60H and powerful.\u001b[K\u001b[1m\u001b[43;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mdeprecated\u001b[39m graceful-fs@2.0.3: please upgrade to graceful-fs 4 for compatibility with current and future v\u001b[44;60Hersions of Node.js\u001b[K\u001b[1m\u001b[45;60Hnpm\u001b(B\u001b[m \u001b[33mwarn\u001b[39m \u001b[94mdeprecated\u001b[39m glob@5.0.15: Old versions of glob are not supported, and c"]
