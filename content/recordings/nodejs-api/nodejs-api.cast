[145.332606, "o", "\u001b[?25l\u001b[2;60Hnodejs-api-examples.zip  nodejs-api-server.q\u001b[K\u001b[38;5;215m\u001b[3;60Hdemo $ \u001b[39mnode --version\u001b[K\u001b[4;60Hv22.23.2\u001b[K\u001b[38;5;215m\u001b[5;60Hdemo $ \u001b[39munzip -q nodejs-api-examples.zip && cd nodejs-api-examples\u001b[K\u001b[38;5;215m\u001b[6;60Hdemo $ \u001b[39mnpm install\u001b[K\u001b[7;60H\u001b[K\nadded 2 packages in 1s\u001b[K\u001b[38;5;215m\u001b[9;60Hdemo $ \u001b[39mnode feed.mjs > feed.log &\u001b[K\u001b[10;60H[1] 406836\u001b[K\u001b[38;5;215m\u001b[11;60Hdemo $ \u001b[39mtail -n 3 feed.log\u001b[K\u001b[12;60HSent 8 trades\u001b[K\u001b[13;60HSent 7 trades\u001b[K\u001b[14;60HSent 4 trades\u001b[K\u001b[38;5;215m\u001b[15;60Hdemo $ \u001b[39mtail -n 3 feed.log\u001b[K\u001b[16;60HSent 7 trades\u001b[K\u001b[17;60HSent 6 trades\u001b[K\u001b[18;60HSent 5 trades\u001b[K\u001b[38;5;215m\u001b[19;60Hdemo $ \u001b[39m# 2. Query the live trades from Node.js.\u001b[K\u001b[38;5;215m\u001b[20;60Hdemo $ \u001b[39mnode query.mjs\u001b[K\u001b[21;60H┌─────────┬────────┬────────┬───────┐\u001b[K\u001b[22;60H│ (index) │ sym    │ trades │ size  │\u001b[K\u001b[23;60H├─────────┼────────┼────────┼─"]
[145.332652, "o", "──────┤\u001b[K\u001b[24;60H│ 0       │ \u001b[32m'A'\u001b[39m    │ \u001b[33m87\u001b[39m     │ \u001b[33m43988\u001b[39m │\u001b[K\u001b[25;60H│ 1       │ \u001b[32m'GM'\u001b[39m   │ \u001b[33m70\u001b[39m     │ \u001b[33m33584\u001b[39m │\u001b[K\u001b[26;60H│ 2       │ \u001b[32m'GOOG'\u001b[39m │ \u001b[33m80\u001b[39m     │ \u001b[33m36951\u001b[39m │\u001b[K\u001b[27;60H│ 3       │ \u001b[32m'KX'\u001b[39m   │ \u001b[33m103\u001b[39m    │ \u001b[33m52631\u001b[39m │\u001b[K\u001b[28;60H└─────────┴────────┴────────┴───────┘\u001b[K\u001b[29;60H┌─────────┬──────────────────────────┬────────┬──────┐\u001b[K\u001b[30;60H│ (index) │ time                     │ price  │ size │\u001b[K\u001b[31;60H├─────────┼──────────────────────────┼────────┼──────┤\u001b[K\u001b[32;60H│ 0       │ \u001b[35m2026-10-08T12:52:34.402Z\u001b[39m │ \u001b[33m148.49\u001b[39m │ \u001b[33m429\u001b[39m  │\u001b[K"]
[145.332661, "o", "\u001b[33;60H│ 1       │ \u001b[35m2026-10-08T12:52:34.903Z\u001b[39m │ \u001b[33m148.23\u001b[39m │ \u001b[33m344\u001b[39m  │\u001b[K\u001b[34;60H│ 2       │ \u001b[35m2026-10-08T12:52:35.912Z\u001b[39m │ \u001b[33m147.93\u001b[39m │ \u001b[33m267\u001b[39m  │\u001b[K\u001b[35;60H└─────────┴──────────────────────────┴────────┴──────┘\u001b[K\u001b[38;5;215m\u001b[36;60Hdemo $ \u001b[39m# A live summary, read back as JavaScript objects.\u001b[K\u001b[38;5;215m\u001b[37;60Hdemo $ \u001b[39m# 3. Subscribe to trade updates and relay them to a browser.\u001b[K\u001b[38;5;215m\u001b[38;60Hdemo $ \u001b[39mnode relay.mjs > relay.log &\u001b[K\u001b[39;60H[2] 409361\u001b[K\u001b[38;5;215m\u001b[40;60Hdemo $ \u001b[39m# Open http://localhost:3000 in a browser for the live chart and trade tape.\u001b[K\u001b[38;5;215m\u001b[41;60Hdemo $ \u001b[39mtail -n 3 relay.log\u001b[K\u001b[42;60Htrade: 5 rows to 1 browser(s)\u001b[K\u001b[43;60Htrade: 5 rows to 1 browser(s)\u001b[K\u001b[44;60Htrade: 7 rows to 1 browser(s)\u001b[K\u001b[38;5;215m\u001b[45;60Hdemo $ \u001b[39m# Each batch of trades reached the browser page over a WebSocket.\u001b"]
[145.332674, "o", "[K\u001b[38;5;215m\u001b[46;60Hdemo $ \u001b[39mkill %1 %2\u001b[K\u001b[38;5;215m\u001b[47;60Hdemo $ \u001b[39m# 4. Run the jkdb and node-q test suites against PeachQ.\u001b[K\u001b[48;60H\u001b[K\u001b[?12l\u001b[?25h\u001b[?25l\u001b[2dv22.23.2\u001b[K\u001b[38;5;215m\u001b[3;60Hdemo $ \u001b[39munzip -q nodejs-api-examples.zip && cd nodejs-api-examples\u001b[K\u001b[38;5;215m\u001b[4;60Hdemo $ \u001b[39mnpm install\u001b[K\u001b[5;60H\u001b[K\nadded 2 packages in 1s\u001b[K\u001b[38;5;215m\u001b[7;60Hdemo $ \u001b[39mnode feed.mjs > feed.log &\u001b[K\u001b[8;60H[1] 406836\u001b[K\u001b[38;5;215m\u001b[9;60Hdemo $ \u001b[39mtail -n 3 feed.log\u001b[K\u001b[10;60HSent 8 trades\u001b[K\u001b[11;60HSent 7 trades\u001b[K\u001b[12;60HSent 4 trades\u001b[K\u001b[38;5;215m\u001b[13;60Hdemo $ \u001b[39mtail -n 3 feed.log\u001b[K\u001b[14;60HSent 7 trades\u001b[K\u001b[15;60HSent 6 trades\u001b[K\u001b[16;60HSent 5 trades\u001b[K\u001b[38;5;215m\u001b[17;60Hdemo $ \u001b[39m# 2. Query the live trades from Node.js.\u001b[K\u001b[38;5;215m\u001b[18;60Hdemo $ \u001b[39mnode query.mjs\u001b[K\u001b[19;60H┌─────────┬────────┬────────┬───────┐\u001b[K\u001b[20;60H│ (index) │ sym    │ trades │ size  │\u001b[K\u001b[21;60H├─────────┼─"]
