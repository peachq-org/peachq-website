[539.0441, "o", "\u001b[?25l\u001b[2d        Add a timeout value to this test to increase the timeout, if this is a long-running test. See https://jest\u001b[3;60Hjs.io/docs/api#testname-fn-timeout.\"\u001b[K\u001b[4;60H\u001b[K\n    \u001b[2m      79 | });\u001b(B\u001b[m\u001b[K\u001b[6;60H    \u001b[2m      80 |\u001b(B\u001b[m\u001b[K\u001b[7;60H    \u001b[2m    > 81 | test('lost connection while querying', done => {\u001b(B\u001b[m\u001b[K\u001b[8;60H    \u001b[2m         | ^\u001b(B\u001b[m\u001b[K\u001b[9;60H    \u001b[2m      82 |   const qProcess = spawn('q', ['-p', '1998']);\u001b(B\u001b[m\u001b[K\u001b[10;60H    \u001b[2m      83 |   qProcess.stdin.write('.z.D', () => {\u001b(B\u001b[m\u001b[K\u001b[11;60H    \u001b[2m      84 |     const q = new QConnection({ port: 1998 });\u001b(B\u001b[m\u001b[K\u001b[12;60H\u001b[K\n    \u001b[2m      at Object.test (\u001b(B\u001b[m\u001b[36mintegration/integration.test.js\u001b[39m\u001b[2m:81:1)\u001b(B\u001b[m\u001b[K\u001b[14;60H\u001b[K\u001b[1m\nTest Suites: \u001b[31m1 failed\u001b(B\u001b[m, 1 total\u001b[K\u001b[1m\u001b[16;60HTests:       \u001b[31m1 failed\u001b(B\u001b[m, \u001b[32m\u001b[1m6 passed\u001b(B\u001b[m, 7 total\u001b[K\u001b[1m\u001b[17;60HSnapshots:   \u001b(B\u001b[m0 total\u001b[K\u001b[1m\u001b[18;60HTime:\u001b(B\u001b[m        5.568 s\u001b[K\u001b[2m\u001b[19;60HRan all test suites matching \u001b(B\u001b[mintegration\u001b[2m.\u001b(B\u001b[m\u001b[K\u001b[1m\u001b[20;60HForce e"]
[539.044158, "o", "xiting Jest: \u001b(B\u001b[mHave you considered using `--detectOpenHandles` to detect async operations that kept running a\u001b[21;60Hfter all tests finished?\u001b[K\u001b[38;5;215m\u001b[22;60Hdemo $ \u001b[39m# All 73 serialisation tests and 6 of 7 integration tests pass; see the article for the one failure.\u001b[K\u001b[38;5;215m\u001b[23;60Hdemo $ \u001b[39mcd .. && git clone -q --depth 1 --branch v2.7.0 https://github.com/michaelwittig/node-q.git\u001b[K\u001b[24;60HNote: switching to '17641112da5296c3c7920de26dc23d8cba73fcf9'.\u001b[K\u001b[25;60H\u001b[K\nYou are in 'detached HEAD' state. You can look around, make experimental\u001b[K\u001b[27;60Hchanges and commit them, and you can discard any commits you make in this\u001b[K\u001b[28;60Hstate without impacting any branches by switching back to a branch.\u001b[K\u001b[29;60H\u001b[K\nIf you want to create a new branch to retain commits you create, you may\u001b[K\u001b[31;60Hdo so (now or later) by using -c with the switch command. Example:\u001b[K\u001b[32;60H\u001b[K\n  git switch -c <new-branch-name>\u001b[K\u001b[34;60H\u001b[K\nOr undo this operation with:\u001b[K\u001b[36;60H\u001b[K\n  git switch -\u001b[K\u001b[38;60H\u001b[K"]
[539.044165, "o", "\nTurn off this advice by setting config variable advice.detachedHead to false\u001b[K\u001b[40;60H\u001b[K\u001b[38;5;215m\ndemo $ \u001b[39mmkdir -p tick && curl -fsSL https://raw.githubusercontent.com/KxSystems/kdb-tick/master/tick/u.q -o tick/u.\u001b[42;60Hq && ls tick\u001b[K\u001b[43;60Hu.q\u001b[K\u001b[38;5;215m\u001b[44;60Hdemo $ \u001b[39mopenssl req -x509 -newkey rsa:2048 -nodes -subj /CN=localhost -keyout key.pem -out cert.pem -days 1 2>/dev/\u001b[45;60Hnull\u001b[K\u001b[38;5;215m\u001b[46;60Hdemo $ \u001b[39mSSL_CERT_FILE=$PWD/cert.pem SSL_KEY_FILE=$PWD/key.pem ./peachq/q -p 6000 -E 2 -q </dev/null >tls.log 2>&1 &\u001b[47;60H[1] 415816\u001b[K\u001b[38;5;215m\u001b[48;60Hdemo $ \u001b[39m\u001b[K\u001b[?12l\u001b[?25h"]
