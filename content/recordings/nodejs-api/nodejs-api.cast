[147.805338, "o", "│ 1       │ \u001b[32m'GM'\u001b[39m   │ \u001b[33m70\u001b[39m     │ \u001b[33m33584\u001b[39m │\u001b[K\u001b[23;60H│ 2       │ \u001b[32m'GOOG'\u001b[39m │ \u001b[33m80\u001b[39m     │ \u001b[33m36951\u001b[39m │\u001b[K\u001b[24;60H│ 3       │ \u001b[32m'KX'\u001b[39m   │ \u001b[33m103\u001b[39m    │ \u001b[33m52631\u001b[39m │\u001b[K\u001b[25;60H└─────────┴────────┴────────┴───────┘\u001b[K\u001b[26;60H┌─────────┬──────────────────────────┬────────┬──────┐\u001b[K\u001b[27;60H│ (index) │ time                     │ price  │ size │\u001b[K\u001b[28;60H├─────────┼──────────────────────────┼────────┼──────┤\u001b[K\u001b[29;60H│ 0       │ \u001b[35m2026-10-08T12:52:34.402Z\u001b[39m │ \u001b[33m148.49\u001b[39m │ \u001b[33m429\u001b[39m  │\u001b[K\u001b[30;60H│ 1       │ \u001b[35m2026-10-08T12:52:34.903Z\u001b[39m │ \u001b[33m148.23\u001b[39m │ \u001b[33m344\u001b[39m  │\u001b[K\u001b[31;60H│ 2    "]
[147.805357, "o", "   │ \u001b[35m2026-10-08T12:52:35.912Z\u001b[39m │ \u001b[33m147.93\u001b[39m │ \u001b[33m267\u001b[39m  │\u001b[K\u001b[32;60H└─────────┴──────────────────────────┴────────┴──────┘\u001b[K\u001b[38;5;215m\u001b[33;60Hdemo $ \u001b[39m# A live summary, read back as JavaScript objects.\u001b[K\u001b[38;5;215m\u001b[34;60Hdemo $ \u001b[39m# 3. Subscribe to trade updates and relay them to a browser.\u001b[K\u001b[38;5;215m\u001b[35;60Hdemo $ \u001b[39mnode relay.mjs > relay.log &\u001b[K\u001b[36;60H[2] 409361\u001b[K\u001b[38;5;215m\u001b[37;60Hdemo $ \u001b[39m# Open http://localhost:3000 in a browser for the live chart and trade tape.\u001b[K\u001b[38;5;215m\u001b[38;60Hdemo $ \u001b[39mtail -n 3 relay.log\u001b[K\u001b[39;60Htrade: 5 rows to 1 browser(s)\u001b[K\u001b[40;60Htrade: 5 rows to 1 browser(s)\u001b[K\u001b[41;60Htrade: 7 rows to 1 browser(s)\u001b[K\u001b[38;5;215m\u001b[42;60Hdemo $ \u001b[39m# Each batch of trades reached the browser page over a WebSocket.\u001b[K\u001b[38;5;215m\u001b[43;60Hdemo $ \u001b[39mkill %1 %2\u001b[K\u001b[38;5;215m\u001b[44;60Hdemo $ \u001b[39m# 4. Run the jkdb and node-q test suites agai"]
