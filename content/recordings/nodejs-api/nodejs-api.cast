[535.936884, "o", "e:\u001b[K\u001b[35;60H\u001b[K\n  git switch -c <new-branch-name>\u001b[K\u001b[37;60H\u001b[K\nOr undo this operation with:\u001b[K\u001b[39;60H\u001b[K\n  git switch -\u001b[K\u001b[41;60H\u001b[K\nTurn off this advice by setting config variable advice.detachedHead to false\u001b[K\u001b[43;60H\u001b[K\u001b[38;5;215m\ndemo $ \u001b[39mmkdir -p tick && curl -fsSL https://raw.githubusercontent.com/KxSystems/kdb-tick/master/tick/u.q -o tick/u.\u001b[45;60Hq && ls tick\u001b[K\u001b[46;60Hu.q\u001b[K\u001b[38;5;215m\u001b[47;60Hdemo $ \u001b[39m\u001b[7mopenssl req -x509 -newkey rsa:2048 -nodes -subj /CN=localhost -keyout key.pem -out cert.pem -days 1 2>/dev/\u001b[48;60Hnull\u001b(B\u001b[m\u001b[K\u001b[?12l\u001b[?25h"]
